.vscode/*
.DS_Store
node_modules/

# Playwright run artifacts (baselines in scripts/visual-regression/baselines ARE committed)
test-results/
playwright-report/

# Incremental build caches (regenerated by verify-mood-parity.mjs)
scripts/.mood-parity-cache.json

# Local, machine-specific deploy target for `npm run deploy` (never commit).
.env
# CodeBuddy local project data (never commit)
.codebuddy/
# Workbuddy local agent memory (never commit)
.workbuddy/
