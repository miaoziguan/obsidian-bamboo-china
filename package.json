{
  "name": "obsidian-bamboo-china",
  "version": "3.2.11",
  "description": "Bamboo China — a native, minimal Obsidian theme.",
  "author": "羽鳞君",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "sass src/theme.scss theme.css --no-source-map --style=expanded",
    "build:min": "sass src/theme.scss theme.css --no-source-map --style=compressed",
    "test": "node scripts/check-css.mjs && node scripts/check-palette-contrast.mjs",
    "watch": "sass --watch src/theme.scss theme.css --no-source-map --style=expanded",
    "deploy": "node scripts/deploy.mjs",
    "release": "npm run build && npm run deploy",
    "sync": "npm run build:min && npm run deploy"
  },
  "devDependencies": {
    "sass": "^1.69.5"
  }
}
